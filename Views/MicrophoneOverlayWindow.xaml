<Window x:Class="whispershortkey.Views.MicrophoneOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Width="270"
        SizeToContent="Height"
        ResizeMode="NoResize">
    <Border x:Name="PanelBorder" CornerRadius="18" BorderThickness="1" Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.30" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- Recording, and transcribing: status line over a level meter. -->
            <StackPanel x:Name="ActivePanel">
                <!-- Two columns, not an overlay: with larger system text the status and the
                     hint would otherwise print on top of each other. -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" Text="Listening" FontSize="13"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HintText" Grid.Column="1" Text="Ctrl+Space" FontSize="10"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Border x:Name="WaveContainer" CornerRadius="9" Padding="8,5">
                    <UniformGrid Rows="1" Columns="8" Height="22" VerticalAlignment="Center">
                        <Border x:Name="Bar1" Width="6" Height="4" CornerRadius="3" VerticalAlignment="Center"/>
                        <Border x:Name="Bar2" Width="6" Height="4" CornerRadius="3" VerticalAlignment="Center"/>
                        <Border x:Name="Bar3" Width="6" Height="4" CornerRadius="3" VerticalAlignment="Center"/>
                        <Border x:Name="Bar4" Width="6" Height="4" CornerRadius="3" VerticalAlignment="Center"/>
                        <Border x:Name="Bar5" Width="6" Height="4" CornerRadius="3" VerticalAlignment="Center"/>
                        <Border x:Name="Bar6" Width="6" Height="4" CornerRadius="3" VerticalAlignment="Center"/>
                        <Border x:Name="Bar7" Width="6" Height="4" CornerRadius="3" VerticalAlignment="Center"/>
                        <Border x:Name="Bar8" Width="6" Height="4" CornerRadius="3" VerticalAlignment="Center"/>
                    </UniformGrid>
                </Border>
            </StackPanel>

            <!-- Failure: stays put until the user retries or dismisses it. -->
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                <Grid Margin="0,0,0,2">
                    <TextBlock x:Name="ErrorTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Grid>

                <TextBlock x:Name="ErrorDetail" FontSize="11" TextWrapping="Wrap"
                           Margin="0,4,0,0" MaxHeight="90" TextTrimming="CharacterEllipsis"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="RetryButton" Content="Retry" MinWidth="74" Height="26"
                            Click="RetryButton_Click"/>
                    <Button x:Name="DismissButton" Content="Close" MinWidth="74" Height="26"
                            Margin="8,0,0,0" Click="DismissButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
