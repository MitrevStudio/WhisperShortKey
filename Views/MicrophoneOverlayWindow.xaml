<Window x:Class="whispershortkey.Views.MicrophoneOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False"
        Width="220" Height="78"
        ResizeMode="NoResize">
    <Border x:Name="PanelBorder" CornerRadius="18" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.30" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="StatusText" Text="Listening" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HintText" Text="Ctrl+Space" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Border x:Name="WaveContainer" CornerRadius="9" Padding="8,5">
                    <UniformGrid Rows="1" Columns="8" Height="22" VerticalAlignment="Center">
                        <Border x:Name="Bar1" Width="6" Height="4" CornerRadius="3" Background="#6C7CFF" VerticalAlignment="Center"/>
                        <Border x:Name="Bar2" Width="6" Height="4" CornerRadius="3" Background="#7888FF" VerticalAlignment="Center"/>
                        <Border x:Name="Bar3" Width="6" Height="4" CornerRadius="3" Background="#8696FF" VerticalAlignment="Center"/>
                        <Border x:Name="Bar4" Width="6" Height="4" CornerRadius="3" Background="#94A4FF" VerticalAlignment="Center"/>
                        <Border x:Name="Bar5" Width="6" Height="4" CornerRadius="3" Background="#94A4FF" VerticalAlignment="Center"/>
                        <Border x:Name="Bar6" Width="6" Height="4" CornerRadius="3" Background="#8696FF" VerticalAlignment="Center"/>
                        <Border x:Name="Bar7" Width="6" Height="4" CornerRadius="3" Background="#7888FF" VerticalAlignment="Center"/>
                        <Border x:Name="Bar8" Width="6" Height="4" CornerRadius="3" Background="#6C7CFF" VerticalAlignment="Center"/>
                    </UniformGrid>
                </Border>
            </StackPanel>

        </Grid>
    </Border>
</Window>
