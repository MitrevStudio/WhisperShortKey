<Window x:Class="whispershortkey.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceTray History"
        Height="620" Width="860" MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Grid.Column="0" Padding="6,4" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>
            <TextBlock x:Name="SearchPlaceholder" Grid.Column="0" Text="Search transcripts…"
                       Margin="9,0,0,0" VerticalAlignment="Center" Opacity="0.5" IsHitTestVisible="False"/>

            <TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Center"
                       Margin="12,0,0,0" Opacity="0.7"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="HistoryList" Grid.Column="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="HistoryList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,5">
                            <Grid>
                                <TextBlock Text="{Binding TimeText}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                           Foreground="{Binding StatusBrush}"
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <TextBlock Text="{Binding MetaText}" FontSize="10" Opacity="0.65" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Preview}" FontSize="11" Margin="0,4,0,0"
                                       TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <DockPanel Grid.Column="2">
                <TextBlock x:Name="DetailHeader" DockPanel.Dock="Top" FontSize="12" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock x:Name="DetailMeta" DockPanel.Dock="Top" FontSize="11" Opacity="0.7"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBox x:Name="DetailText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontSize="12" Padding="6"/>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Padding rather than fixed sizes, and a WrapPanel rather than a StackPanel:
                 with larger system text or a narrow window, fixed buttons clip instead of
                 reflowing, which is how the row ends up half cut off. -->
            <WrapPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="PlayButton" Content="Play" MinWidth="84" Padding="12,5"
                        Margin="0,0,8,6" Click="PlayButton_Click"/>
                <Button x:Name="CopyButton" Content="Copy text" MinWidth="84" Padding="12,5"
                        Margin="0,0,8,6" Click="CopyButton_Click"/>
                <Button x:Name="RetranscribeButton" Content="Re-transcribe" MinWidth="104" Padding="12,5"
                        Margin="0,0,8,6" Click="RetranscribeButton_Click"/>
                <Button x:Name="DeleteButton" Content="Delete" MinWidth="84" Padding="12,5"
                        Margin="0,0,8,6" Click="DeleteButton_Click"/>
            </WrapPanel>

            <WrapPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ClearButton" Content="Clear history" MinWidth="104" Padding="12,5"
                        Margin="0,0,8,6" Click="ClearButton_Click"/>
                <Button Content="Close" MinWidth="84" Padding="12,5" Margin="0,0,0,6"
                        IsCancel="True" Click="CloseButton_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
